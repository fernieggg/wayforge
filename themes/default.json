{
  "$schema": "../schema/theme.schema.json",
  "fonts": {
    "heading": { "family": "Unbounded", "weights": [400, 500], "fallback": "system-ui, sans-serif" },
    "text": { "family": "Figtree", "weights": [400, 500, 600], "fallback": "system-ui, -apple-system, \"Segoe UI\", sans-serif" }
  },
  "colors": {
    "light": {
      "bg": "#eef2fb", "ink": "#0c1633", "muted": "#55628c",
      "node": "#ffffff", "node-line": "#b9c6ea", "panel": "rgba(106,82,224,.06)",
      "sys": "#1d6fd8", "deep": "#6a52e0", "deep-soft": "rgba(106,82,224,.15)",
      "packet": "#e08a00", "glass": "rgba(255,255,255,.78)", "btn-ink": "#ffffff",
      "grid": "rgba(20,40,120,.09)", "glow": "rgba(29,111,216,.10)",
      "pink": "#d6336c", "teal": "#0b9a74", "panel-pink": "rgba(214,51,108,.05)", "panel-teal": "rgba(11,154,116,.06)",
      "lime": "#4c8a00", "lime-soft": "rgba(76,138,0,.14)"
    },
    "dark": {
      "bg": "#070b18", "ink": "#e9eeff", "muted": "#8e9bc6",
      "node": "#101a3a", "node-line": "#2a3c78", "panel": "rgba(165,150,255,.05)",
      "sys": "#5cc8ff", "deep": "#a596ff", "deep-soft": "rgba(165,150,255,.2)",
      "packet": "#ffc15a", "glass": "rgba(12,19,42,.78)", "btn-ink": "#06101f",
      "grid": "rgba(120,150,255,.10)", "glow": "rgba(92,200,255,.10)",
      "pink": "#ff8fa8", "teal": "#4fe3b5", "panel-pink": "rgba(255,143,168,.04)", "panel-teal": "rgba(79,227,181,.04)",
      "lime": "#b8f26a", "lime-soft": "rgba(184,242,106,.16)"
    }
  },
  "defaultTone": "blue",
  "tones": {
    "blue": { "color": "sys" },
    "violet": { "color": "deep", "soft": "deep-soft", "panel": "panel" },
    "pink": { "color": "pink", "panel": "panel-pink" },
    "teal": { "color": "teal", "panel": "panel-teal" },
    "lime": { "color": "lime", "soft": "lime-soft" }
  },
  "opacity": { "node": 0.32, "edge": 0.5, "label": 0.35, "dim": 0.45 },
  "metrics": {
    "box": { "radius": 16, "inset": 22, "titleDy": 8, "titleDySub": -2, "subDy": 24, "stroke": 1.5, "strongStroke": 2.2 },
    "circle": { "titleDy": 7, "subGap": 28 },
    "diamond": { "titleDy": 7, "subGap": 34 },
    "container": {
      "radius": 20, "titleOffset": [26, 50], "rowsTop": 80, "rowInset": 24, "rowTextInset": 18,
      "rowHeight": 32, "rowPitch": 40, "rowRadius": 10, "rowTextDy": 22, "rowStroke": 1,
      "highlightFillOpacity": 0.3, "highlightStroke": 2.6
    },
    "pill": { "height": 24, "inset": 10, "charWidth": 7.6, "padding": 26, "textDy": 5 },
    "edge": { "stroke": 2, "activeStroke": 2.5, "dash": [7, 9] },
    "panel": { "radius": 28, "stroke": 1.2, "dash": [3, 9] },
    "zoomBadge": { "radius": 11, "inset": 16 },
    "type": { "title": 22, "subtitle": 17, "containerTitle": 21, "row": 18, "label": 16, "panelTitle": 18, "pill": 13 }
  },
  "motion": {
    "fade": 0.6, "decorFade": 0.8, "stroke": 0.5, "glide": 0.9, "glideEase": "cubic-bezier(.65,0,.35,1)",
    "camera": 1.3, "caption": 0.16, "pillFade": 0.4, "row": 0.4, "rowCycle": 1.1, "swipe": 50, "zoom": 1.6
  },
  "packet": {
    "speed": 300, "hold": 0.9, "tail": 7, "gap": 15, "fade": 50,
    "headRadius": 9, "radiusStep": 1.1, "minRadius": 2,
    "glowRadius": 20, "glowBlur": 7, "glowOpacity": 0.85, "reducedMotionAt": 0.55
  },
  "background": { "gridDot": 1.3, "gridSpacing": 34 },
  "lint": { "minTextPx": 11, "referenceScreenWidth": 1440 }
}
